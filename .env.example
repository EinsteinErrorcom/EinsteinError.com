# Supabase (Settings > API) — required for auth and session refresh
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — server-side fallback only; browser OAuth uses the current domain
# NEXT_PUBLIC_SITE_URL=https://www.einsteingravity.com

# Lemon Squeezy — use ONE of these options for the prices page (/trial-expired redirect):
#
# Option A (easiest): your store subdomain only — builds https://YOUR-SLUG.lemonsqueezy.com
# Find it in Lemon Squeezy → Settings → Stores (the part before .lemonsqueezy.com)
# NEXT_PUBLIC_LEMON_SQUEEZY_STORE_SLUG=your-store-name
#
# Option B: full store/prices URL
# NEXT_PUBLIC_LEMON_SQUEEZY_PRICES_URL=https://your-store.lemonsqueezy.com
#
# Note: IDs starting with acct_ are Stripe account IDs (from Stripe migration docs),
# not Lemon Squeezy store URLs. Lemon Squeezy uses a store slug or numeric store ID.

# Lemon Squeezy checkout — full URL OR store slug + variant ID:
# NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-variant-id
# NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID=your-variant-id

# Vercel: add all variables above in Project Settings > Environment Variables
# for Production, Preview, and Development environments.

# --- Google OAuth setup ---
#
# Fixes "redirect_uri_mismatch":
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
#    Authorized redirect URI (exactly one for Supabase):
#      https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#    Do NOT add http://localhost:3000/auth/callback here.
#
# Fixes "Unable to exchange external code" / unexpected_failure:
# 2. Supabase Dashboard → Authentication → Providers → Google
#    Enable Google and paste the SAME Client ID + Client Secret from step 1.
#    If you regenerated the secret in Google, update Supabase too.
#    OAuth consent screen must be configured; in Testing mode, add your Google
#    account under Test users.
#
# 3. Supabase Dashboard → Authentication → URL Configuration
#    Site URL (production): https://www.einsteingravity.com
#    Redirect URLs (no hyphens — use einsteingravity.com, not einstein-gravity.com):
#      http://localhost:3000/auth/callback
#      https://zzzbestmaxlit.vercel.app/auth/callback
#      https://www.einsteingravity.com/auth/callback
#      https://www.einsteinerror.com/auth/callback
#
# 4. Copy the real anon key from Supabase Settings → API into .env.local
#    (not "your-anon-key" — JWT keys start with eyJ).
