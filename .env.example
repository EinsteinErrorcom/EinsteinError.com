# Supabase (Settings > API) — required for auth and session refresh
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dev only — required for GET /api/dev/reset (local testing)
# Supabase Dashboard → Settings → API → service_role (never expose in client or production)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider — switch models by changing ONE variable (server-side only)
# Options: gemini | openai | anthropic | grok
AI_PROVIDER=gemini

# Optional model override (defaults per provider if omitted)
# AI_MODEL=gemini-flash-latest
# AI_MODEL=gpt-4o-mini
# AI_MODEL=claude-3-5-haiku-20241022
# AI_MODEL=grok-2-latest

# Provider API keys — set only the key for your active AI_PROVIDER
# Google AI Studio → https://aistudio.google.com/apikey
# If quota is depleted: create a key in Default Gemini Project or a new project (free tier).
# AI Studio "Set up prepay" is NOT available on all billing accounts — use Cloud Console
# billing (https://console.cloud.google.com/billing) or switch AI_PROVIDER instead.
# Multiple keys supported (comma-separated) — first working key is used.
GEMINI_API_KEY=your-gemini-api-key
# OpenAI → https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Anthropic → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
# xAI (Grok) → https://console.x.ai/
XAI_API_KEY=your-xai-api-key

# Google OAuth — Web Client ID from Google Cloud Console → Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=495417569663-hvj538m26imrr1ee1igpoa9ve4f3lceh.apps.googleusercontent.com

# Stripe Payment Element (server secret + client publishable key)
STRIPE_SECRET_KEY=sk_live_your-secret-key
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_your-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key

# Site URL — required on Vercel so post-sign-in redirects go to the right domain
NEXT_PUBLIC_SITE_URL=https://zzzbestmaxlit.vercel.app

# Optional local override in .env.local:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev only — placeholder chat when Gemini/OpenAI key is missing or out of quota
# AI_DEV_MOCK_FALLBACK=true

# Production safeguards
# Max chat requests per authenticated user per hour (default 20)
CHAT_RATE_LIMIT_PER_HOUR=20
# Cache long system instructions server-side to reduce Gemini input token cost
GEMINI_CONTEXT_CACHE=true

# Vercel: add all variables above (including GEMINI_API_KEY) in Project Settings >
# Environment Variables for Production, Preview, and Development environments.
#
# Production launch checklist:
# 1. GEMINI_API_KEY lives ONLY in server env (Vercel), never NEXT_PUBLIC_* or client code
# 2. Default model is gemini-flash-latest (Google-maintained alias)
# 3. Run supabase migration 20260802120000_chat_rate_limits.sql for durable rate limits
# 4. Set Google Cloud Billing budgets/alerts: https://console.cloud.google.com/billing/budgets
# 5. Gemini quota: use free-tier project key or Cloud billing — AI Studio prepay is not universal

# --- Google OAuth setup ---
#
# Fixes "Error 400: origin_mismatch" (Google Sign-In button):
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
#    Authorized JavaScript origins — add EVERY domain where users click Sign in:
#      http://localhost:3000
#      https://www.einsteinerror.com
#      https://einsteinerror.com
#      https://www.einsteingravity.com
#      https://einsteingravity.com
#      https://zzzbestmaxlit.vercel.app
#    (No path — origin only. Changes may take 1–5 minutes.)
#
# Fixes "redirect_uri_mismatch" (Supabase OAuth callback):
# 2. Same Google OAuth client → Authorized redirect URIs (exactly one for Supabase):
#      https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#    Do NOT add http://localhost:3000/auth/callback here.
#
# 3. Supabase Dashboard → Authentication → Providers → Google
#    Enable Google. Set BOTH fields from the SAME Google OAuth Web client:
#    Client ID:  495417569663-hvj538m26imrr1ee1igpoa9ve4f3lceh.apps.googleusercontent.com
#    Client Secret: (copy from Google Cloud → Credentials → that client)
#    If you see "Authorized Client IDs" — paste the Client ID there too (comma-separated if multiple).
#
# 4. Supabase Dashboard → Authentication → URL Configuration
#    Site URL (production): https://www.einsteinerror.com
#    Redirect URLs — add every domain you use:
#      http://localhost:3000/auth/callback
#      https://zzzbestmaxlit.vercel.app/auth/callback
#      https://www.einsteingravity.com/auth/callback
#      https://www.einsteinerror.com/auth/callback
#
# 5. Copy the real anon key from Supabase Settings → API into .env.local
#    (not "your-anon-key" — JWT keys start with eyJ).
